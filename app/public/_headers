# Cache rules for Cloudflare Workers Static Assets (ADR 0008). Never uploaded or served itself.
# Rules that match the same path join their values, so no path may match two of these.

# Always asked again, so a new deploy is found on the next launch.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Named by their content's hash, so a file under one name never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/catalog/*
  Cache-Control: public, max-age=31536000, immutable
