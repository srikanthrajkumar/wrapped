# Names only; the values go in app/.env, which is never committed (CONTRIBUTING.md).
# A build without them has no server: logging and export work, and sync waits (FR-018).

# The Supabase project's API address, e.g. http://127.0.0.1:54321 for the local stack.
VITE_SUPABASE_URL=
# The Supabase public (anon) key. Safe in the browser by design.
VITE_SUPABASE_ANON_KEY=
