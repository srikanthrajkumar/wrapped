# Names only; the values go in supabase/.env, which is never committed (CONTRIBUTING.md).
# The Supabase CLI reads supabase/.env for the env(...) values in config.toml.

# The Google OAuth web client used by Supabase Auth (ADR 0001, T077).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
